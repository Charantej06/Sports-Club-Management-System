DATABASE_URL=postgresql://champions:champions_local_only@127.0.0.1:5433/champions
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
PAYMENT_MODE=local
# Alternative: PAYMENT_MODE=razorpay (requires all three keys; never commit live credentials)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email: "local" stores messages in the owner's Local test inbox and sends nothing.
# Set EMAIL_MODE=smtp to send real email. Step-by-step guide: docs/SMTP.md
# Verify with: npm run mail:verify -- you@example.com   (restart app and worker after editing)
EMAIL_MODE=local
SMTP_HOST=
SMTP_PORT=587
# Optional: force implicit TLS (true) or STARTTLS (false). Default: true only on port 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Must be a sender your provider has verified, e.g. Champions Club <club@your-domain.com>
EMAIL_FROM=Champions Club <club@champions.local>
# Compose only; use a URL-safe password and keep DATABASE_URL consistent.
POSTGRES_PASSWORD=champions_local_only
